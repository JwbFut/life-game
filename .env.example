# Read by prisma.config.ts. The URL also picks the schema: postgres:// uses
# prisma/schema.postgres.prisma, anything else uses the SQLite schema.
LIFE_DATABASE_URL="file:./data/life.db"

# Production
# LIFE_DATABASE_URL="postgresql://user:password@host:5432/life"

# Runtime override for the SQLite file. Defaults to <cwd>/data/life.db.
# LIFE_DB_PATH=./data/life.db
